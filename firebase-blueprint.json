{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "User profile document stored in Firestore",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique user ID matching auth.uid"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "User profile avatar URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["uid", "email"]
    },
    "savedNote": {
      "title": "Saved Study Note",
      "description": "User saved lecture study note document",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique note ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "title": {
          "type": "string",
          "maxLength": 300,
          "description": "Title of the lecture note"
        },
        "fileName": {
          "type": "string",
          "maxLength": 300,
          "description": "Original source PDF file name"
        },
        "core_points": {
          "type": "array",
          "description": "List of core lecture points"
        },
        "key_terms": {
          "type": "array",
          "description": "List of key terms and definitions"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "userId", "title", "core_points", "key_terms"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profile storage"
    },
    "/users/{userId}/saved_notes/{noteId}": {
      "schema": "savedNote",
      "description": "User saved study notes subcollection"
    }
  }
}
